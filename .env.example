# ============================================================
# FedEx Email Auto-Flagger — Configuration
# This file is managed automatically by the dashboard UI.
# Do NOT edit manually — use Settings at http://localhost:5000/settings
# NEVER commit .env to Git — it contains sensitive API tokens.
# ============================================================

# Portal API token — set via Setup Wizard on first launch
PORTAL_API_TOKEN=

# Outlook shared mailbox URL
OUTLOOK_MAILBOX_URL=https://outlook.cloud.microsoft/mail/pn@registrarcorp.com/

# Only process emails from this sender
SENDER_FILTER=myfda@registrarcorp.com

# How often to run a full scan cycle (seconds). Default: 120 (2 minutes)
CHECK_INTERVAL_SECONDS=120

# How many days back to fetch from portal. Default: 2
API_DATE_RANGE_DAYS=2

# Dashboard web server port
DASHBOARD_PORT=5000

# DRY RUN: true = log decisions but do NOT actually flag emails
# Set to false only after validating dry run output is correct
DRY_RUN=true

# Chrome profile directory for Playwright Outlook login
BROWSER_PROFILE_DIR=./browser_profile

# Auto-start with Windows (managed via Settings page)
AUTO_START_WINDOWS=false

# Outlook Bearer token — auto-saved by the bot after each successful login.
# Can also be pasted manually via Settings → Outlook Manual Session.
OUTLOOK_AUTH_TOKEN=

# Outlook OWA Canary cookie — auto-saved alongside the Bearer token.
# Can also be pasted manually via Settings → Outlook Manual Session.
OUTLOOK_OWA_CANARY=

